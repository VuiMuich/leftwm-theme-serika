#!/usr/bin/env nu

# volume.nu

def update_sink [] {
    # This is a placeholder in case you later want to change sinks dynamically.
    # `@DEFAULT_SINK@` is used directly in wpctl.
    null
}

def volume_up [] {
    update_sink
    wpctl set-volume @DEFAULT_SINK@ "1%+"
}

def volume_down [] {
    update_sink
    wpctl set-volume @DEFAULT_SINK@ "1%-"
}

def volume_mute [] {
    update_sink
    wpctl set-mute @DEFAULT_SINK@ toggle
}

def volume_print [] {
    let muted = (
      wpctl get-volume @DEFAULT_SINK@
      | str contains "[MUTED]"
    )

    let active_port = (
        pw-dump
        | from json
        | where type == "PipeWire:Interface:Node"
        | where info.props."media.class"? == "Audio/Sink"
        | get info.props."node.name"
        | get 0
        | parse -r '.*\.(?P<port_type>[^.]+)$'
        | get port_type
        | get 0
    )

    let icon = match $active_port {
        'headphones' => { if $muted { "󰋋" } else { "󰟎" }},
        'headset' => { if $muted { "󰋎" } else { "󰋐" }},
        'hdmi' => { if $muted { "󰽟" } else { "󰽠" }},
        'analog-stereo' => { if $muted { "󰓄" } else { "󰓃" }},
        _ => "󰓃"
    }

    print $icon
}

def main [arg?: string = ""] {
    match $arg {
        "up" => volume_up,
        "down" => volume_down,
        "mute" => volume_mute,
        _ => volume_print
    }
}
