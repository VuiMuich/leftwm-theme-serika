; Widgets
(defwidget niri-stuff []
    (box :class "niristuff"
         :orientation "h"
         :space-evenly false
         :halign "center"
        (time)
        (weather)
        (circular-metric :label "󰐿"
                :label-class "icon-small"
                :value '${EWW_RAM.used_mem_perc}'
                :tooltip  'Mem Usage: ${round(EWW_RAM.used_mem_perc, 1)} %'
                :onchange "")
        (circular-metric :label ""
                :label-class "icon-smaller"
                :value {wifi.signal ?: "0.0"}
                :tooltip "Wifi Network: ${wifi.ssid ?: "not connected"}
Wifi Strength: ${wifi.signal ?: "0.0"} %"
                :onchange "")
        (circular-metric :label {EWW_BATTERY["BAT0"].status == "Discharging" ? "󰄌" : "󰚥"}
                :label-class {EWW_BATTERY["BAT0"].status == "Discharging" ? "icon-bat"  : "icon-smaller"}
                :value  '${EWW_BATTERY["BAT0"].capacity}'
                :tooltip 'Battery Level: ${EWW_BATTERY["BAT0"].capacity} %'
                :onchange "")
        (metric :label '${getpa.icon}'
                :label-class {getpa.icon == "󰋋"
                           || getpa.icon == "󰟎"
                           || getpa.icon == "󰋎"
                           || getpa.icon == "󰋐"
                           || getpa.icon == "󰽟"
                           || getpa.icon == "󰽠"
                            ? "icon-small" : "icon-smaller"}
                :value '${getpa.volume}'
                :tooltip 'Volume: ${getpa.volume} %'
                :onchange  "wpctl set-volume @DEFAULT_SINK@ {}%")
        (window-title)))

(defwidget circular-metric [label label-class value tooltip onchange]
  (box :orientation "h"
       :space-evenly false
    (box :class label-class label)
    (box :class "icon" :vexpand "false" :hexpand "false"
       (circular-progress  :active {onchange != ""}
                :class {value <= 25 ? "circular-meter-crit" : "circular-meter"}
                :value value
                :tooltip tooltip
                :thickness 3)
       (button 
                :class "icon-small"
                :onclick "$HOME/.config/eww/bar/scripts/pop system"
                ""))))
             
(defwidget metric [label label-class value tooltip onchange]
  (box :orientation "h"
       :class "metric"
       :space-evenly false
       :tooltip tooltip
    (box :class label-class label)
    (scale :min 0
           :max 101
           :active {onchange != ""}
           :value value
           :onchange onchange)))

(defwidget keyboard-layout []
    (box :class "icon-key"
         :orientation "h"
         :space-evenly false
         :halign "start"
        {kbd-layout != "" ? kbd-layout : ""}))

(defwidget window-title []
    (box :class "ws-layout"
         :space-evenly false
         :halign "start" 
         :valign "start"
         :width 340
        (box :class "icon-ws-layout" "󰧨")
        (label
         :limit-width 55
         :show-truncated true
         :text "${nirimsgwin.title ?: "Desktop"}")))

(defwidget time []
      (box :class "time"
           :space-evenly false
           :halign "start"
           :tooltip {formattime(EWW_TIME, "%a %d. %m. %Y")}
           (button :onclick "eww open --toggle uhr" :class "icon-time" "󰥔")
           {formattime(EWW_TIME, "%H:%M")} (box :class "time-sec" {formattime(EWW_TIME, ":%S")})))

(defwidget uhr []
    (box :class "uhr"
        {uhrwerk}))

(defwidget lock []
    (box :class "lock"
        {uhrwerk}))

(defwidget systemtray []
    (systray :pack-direction "ltr"))

(defwidget weather []
    (box :orientation "h"
         :space-evenly false
         (box :class "icon-small" "")
         (box :class "time" "${weather}")))

; Variables
(defvar pwmen-open false)
(defpoll weather :initial "" :interval "15min" "curl -s wttr.in/?format=3")
(defpoll getpa :initial '{"volume":0.5,"muted":false,"icon":"󰓃"}' :interval "10s" "scripts/getpa")
(defpoll wifi :initial '{"active":"yes","ssid":"n/c","signal":"0"}' :interval "10s" "scripts/getwifi")
(deflisten uhrwerk "uhrwerk -t $HOME/Git/uhrwerk/time-in-words-templates/de_1.ron")
(deflisten kbd-layout "scripts/get-kbd-layout")
(deflisten nirimsgwin :initial '{"title":"N/A"}' "scripts/getwindow")

; Windows
(defwindow niribar
           :monitor 0
           :geometry (geometry :x "0px"
                               :y "10px"
                               :anchor "top center")
           :exclusive true
           :focusable "none"
           :stacking "bottom"
           (niri-stuff))

(defwindow tray
           :monitor 0
           :windowtype "dialog"
           :wm-ignore true
           :focusable true
           :geometry (geometry :x "348px"
                               :y "10px"
                               :width "327px"
                               ; :height "34px"
                               :height "34px" ; this is a workaround, as gtk is expanding the height to this anyways
                               :anchor "top left")
           :reserve (struts :side "top" :distance "55px")
           :exclusive true
           :stacking "bg"
           (systemtray)) 

(defwindow uhr
           :monitor 0
           :windowtype "dialog"
           :wm-ignore true
           :geometry (geometry :x "89px"
                               :y "-89px"
                               :width "600px"
                               :height "55"
                               :anchor "bottom left")
           :stacking "fg"
           :focusable "none"
           (uhr))

(defwindow lock
           :monitor 0
           :windowtype "desktop"
           :stacking "fg"
           :wm-ignore true
           :focusable "none"
           :geometry (geometry :x "0"
                               :y "0"
                               :width "100%"
                               :height "100%"
                               :anchor "top left")
           (lock))
