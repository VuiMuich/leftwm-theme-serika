#! /usr/bin/env nu
# Get mute and volume
let volume_info = (wpctl get-volume @DEFAULT_SINK@)
let is_muted = ($volume_info | str contains "[MUTED]")
let volume = ($volume_info | str replace  " [MUTED]"  "" | parse "Volume: {vol}" | get vol.0 | into float | $in * 100 )

# Get active port type
let port_type = (
  pw-dump
  | from json
  | where type == "PipeWire:Interface:Device"
  | where info.props."media.class" == "Audio/Device"
  | get info.params.EnumRoute
  | flatten
  | where direction == "Output" and available != "no"
  | sort-by priority
  | get 0.info.2
)

# Pick icon
let icon = match $port_type {
      'headphones' => { if $is_muted { "󰟎" } else { "󰋋" }},
      'headset' => { if $is_muted { "󰋐" } else { "󰋎" }},
      'hdmi' => { if $is_muted { "󰽠" } else { "󰽟" }},
      'speaker' => { if $is_muted { "󰓄" } else { "󰓃" }},
      _ => "󰓃"
}

# Final output for Eww
{
  volume: $volume
  muted: $is_muted
  icon: $icon
}
| to json
