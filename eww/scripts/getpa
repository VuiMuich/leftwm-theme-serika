#!/usr/bin/env nu

# volume.nu

def update_sink [] {
    # This is a placeholder in case you later want to change sinks dynamically.
    # `@DEFAULT_SINK@` is used directly in wpctl.
    null
}

def get_volume [] {
    
}

def volume_up [] {
    update_sink
    wpctl set-volume @DEFAULT_SINK@ "1%+"
}

def volume_down [] {
    update_sink
    wpctl set-volume @DEFAULT_SINK@ "1%-"
}

def toggle_mute [] {
    update_sink
    wpctl set-mute @DEFAULT_SINK@ toggle
}

def icon_print [] {
    let muted = (
        wpctl get-volume @DEFAULT_SINK@
        | str contains "[MUTED]"
    )

    let active_port = (
        pw-dump
        | from json
        | where type == "PipeWire:Interface:Device"
        | where info.props."media.class"? == "Audio/Device"
        | get info.params.EnumRoute
        | flatten
        | where direction == "Output" and available != "no"
        | sort-by priority
        | get 0.info.2
    )

    let icon = match $active_port {
        'headphones' => { if $muted { "󰋋" } else { "󰟎" }},
        'headset' => { if $muted { "󰋎" } else { "󰋐" }},
        'hdmi' => { if $muted { "󰽟" } else { "󰽠" }},
        'speaker' => { if $muted { "󰓄" } else { "󰓃" }},
        _ => "󰓃"
    }

    print $icon
}

def main [arg?: string = ""] {
    match $arg {
        "up" => volume_up,
        "down" => volume_down,
        "mute" => toggle_mute,
        "volume" => get_volume,
        "switch" => update_sink,
        _ => icon_print
    }
}
