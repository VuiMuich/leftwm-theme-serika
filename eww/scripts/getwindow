#!/usr/bin/env bash

socket_path="${NIRI_SOCKET:?NIRI_SOCKET not set}"

focused_id=""
windows_json="[]"

{
  echo '"EventStream"'
  cat
} | nc -U "$socket_path" | while IFS= read -r line; do
  if echo "$line" | jaq -e 'has("WindowsChanged")' >/dev/null; then
    windows_json=$(echo "$line" | jaq -c '.WindowsChanged.windows')

    if [[ -z "$focused_id" ]]; then
      focused_id=$(echo "$line" | jaq -r '.WindowsChanged.windows[] | select(.is_focused == true) | .id')
      if [[ -n "$focused_id" ]]; then
        echo "$windows_json" | jaq --compact-output --argjson id "$focused_id" '.[] | select(.id == $id)'
      fi
    fi
  fi

  if echo "$line" | jaq -e 'has("WindowFocusChanged")' >/dev/null; then
    new_focused_id=$(echo "$line" | jaq '.WindowFocusChanged.id')
    if [[ "$new_focused_id" != "$focused_id" ]]; then
      focused_id="$new_focused_id"
      echo "$windows_json" | jaq --compact-output --argjson id "$focused_id" '.[] | select(.id == $id)'
    fi
  fi
done
